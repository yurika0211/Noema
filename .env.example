# Copy to a file that is not committed. Values here are names and placeholders only.

# Required for -listen / scripts/noema-up.sh. Same value the Android app sends as Authorization: Bearer.
NOEMA_BIND_KEY=

# Model provider. Required for NOEMA_MODE=live. Empty fails the script before listen.
# Probe mode (healthz / capabilities only) does not call the provider.
NOEMA_API_KEY=
NOEMA_API_BASE=
NOEMA_PROVIDER=openai
NOEMA_MODEL=

# live = real provider. probe = listen only, no model turn.
NOEMA_MODE=live

# Loopback by default. Use 0.0.0.0:8787 only for a physical device, and keep BIND_KEY set.
NOEMA_LISTEN=127.0.0.1:8787

# Lucky HomeDir owned by Noema. Never ~/.luckyagent.
NOEMA_HOME=./data/lucky-home

# Event log. Must stay outside NOEMA_HOME.
NOEMA_STATE_DIR=./data/noema-state
